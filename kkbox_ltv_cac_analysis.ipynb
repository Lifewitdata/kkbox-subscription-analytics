   "source": [
    "## 4. Cohort Heatmap (Book of Business)\n",
    "\n",
    "A classic SaaS cohort heatmap: each row is a registration month, each column is months-since-signup,\n",
    "and the color is retention. Reads diagonally — you can see whether *newer* cohorts retain better or\n",
    "worse than older ones, independent of channel."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "769ef4df",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-30T16:29:36.404837Z",
     "iopub.status.busy": "2026-08-30T16:29:36.404664Z",
     "iopub.status.idle": "2026-08-30T16:29:38.181589Z",
     "shell.execute_reply": "2026-08-30T16:29:38.180561Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1300x700 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "ledger[\"reg_month\"] = ledger[\"registration_init_time\"].dt.to_period(\"M\").astype(str)\n",
    "\n",
    "rows = []\n",
    "for row in ledger.itertuples(index=False):\n",
    "    start, end = int(row.age_start_month), int(row.age_end_month)\n",
    "    end = max(end, start + 1)\n",
    "    for m in range(start, end):\n",
    "        rows.append((row.reg_month, m, row.msno))\n",
    "active_cal = pd.DataFrame(rows, columns=[\"reg_month\", \"age_month\", \"msno\"]).drop_duplicates()\n",
    "cohort_counts = active_cal.groupby([\"reg_month\", \"age_month\"])[\"msno\"].nunique().reset_index(name=\"n\")\n",
    "\n",
    "cohort_totals = members.groupby(members[\"registration_init_time\"].dt.to_period(\"M\").astype(str))[\"msno\"].nunique()\n",
    "cohort_counts[\"cohort_total\"] = cohort_counts[\"reg_month\"].map(cohort_totals)\n",
    "cohort_counts[\"retention\"] = cohort_counts[\"n\"] / cohort_counts[\"cohort_total\"]\n",
    "\n",
    "heat = cohort_counts.pivot(index=\"reg_month\", columns=\"age_month\", values=\"retention\")\n",
    "heat = heat.loc[sorted(heat.index)]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 7))\n",
    "im = ax.imshow(heat.values * 100, aspect=\"auto\", cmap=\"YlGnBu\", vmin=0, vmax=100)\n",
    "ax.set_xticks(range(0, heat.shape[1], 2))\n",
    "ax.set_xticklabels(heat.columns[::2])\n",
