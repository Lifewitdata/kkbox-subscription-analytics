    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "for channel in cohort_size.index:\n",
    "    r = retention[retention.channel == channel].sort_values(\"age_month\")\n",
    "    r_solid = r[r.eligible_users >= MIN_ELIGIBLE]\n",
