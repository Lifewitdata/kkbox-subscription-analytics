   "source": [
    "\n",
    "PROJECT_TO = 24\n",
    "extrap = {}\n",
    "\n",
    "for channel in cohort_size.index:\n",
    "    r = retention[retention.channel == channel].sort_values(\"age_month\")\n",
    "    r_reliable = r[(r.eligible_users >= MIN_ELIGIBLE) & (r.age_month >= 1)]\n",
    "\n",
    "    x = r_reliable[\"age_month\"].values\n",
    "    y = np.log(r_reliable[\"retention_rate\"].clip(lower=1e-4).values)\n",
    "    b, a = np.polyfit(x, y, 1)\n",
    "    monthly_decay = np.exp(b)\n",
    "\n",
    "    last_reliable_age = int(r_reliable[\"age_month\"].max())\n",
    "    last_reliable_retention = float(r[r.age_month == last_reliable_age][\"retention_rate\"].iloc[0])\n",
    "\n",
    "    arpu_window = ltv_df[(ltv_df.channel == channel) & (ltv_df.age_month.between(1, last_reliable_age))]\n",
    "    steady_arpu = arpu_window[\"arpu_per_active_user\"].mean()\n",
    "\n",
    "    ltv_at_last_reliable = float(ltv_df[(ltv_df.channel == channel) & (ltv_df.age_month == last_reliable_age)][\"ltv_observed\"].iloc[0])\n",
    "\n",
    "    curve = {age: float(ltv_df[(ltv_df.channel == channel) & (ltv_df.age_month == age)][\"ltv_observed\"].iloc[0])\n",
    "             for age in ltv_df[ltv_df.channel == channel][\"age_month\"] if age <= last_reliable_age}\n",
    "\n",
    "    retention_t, cum_ltv = last_reliable_retention, ltv_at_last_reliable\n",
    "    for t in range(last_reliable_age + 1, PROJECT_TO + 1):\n",
    "        retention_t *= monthly_decay\n",
    "        cum_ltv += retention_t * steady_arpu\n",
    "        curve[t] = cum_ltv\n",
    "\n",
    "    extrap[channel] = dict(monthly_decay=monthly_decay, last_reliable_age=last_reliable_age,\n",
    "                            steady_arpu=steady_arpu, curve=curve)\n",
    "\n",
    "summary = pd.DataFrame({\n",
    "    ch: dict(monthly_retention_decay=v[\"monthly_decay\"], last_reliable_age_mo=v[\"last_reliable_age\"],\n",
    "             steady_arpu_ntd=round(v[\"steady_arpu\"], 1))\n",
    "    for ch, v in extrap.items()\n",
    "}).T\n",
    "summary\n"
   ]
