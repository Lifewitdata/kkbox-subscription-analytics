   "source": [
    "\n",
    "MAX_AGE_MONTHS = 30\n",
    "MIN_ELIGIBLE = 400  # below this sample size we stop trusting the observed curve and extrapolate instead\n",
    "\n",
    "elig_rows = []\n",
    "for channel, grp in members.groupby(\"channel\"):\n",
    "    for age in range(MAX_AGE_MONTHS):\n",
    "        threshold = DATA_CUTOFF - pd.Timedelta(days=30 * age)\n",
    "        n_eligible = (grp[\"registration_init_time\"] <= threshold).sum()\n",
    "        elig_rows.append((channel, age, n_eligible))\n",
    "eligible = pd.DataFrame(elig_rows, columns=[\"channel\", \"age_month\", \"eligible_users\"])\n",
    "\n",
    "# Active-user expansion: each transaction covers the age-bucket range [start, end),\n",
    "# exclusive of the end bucket -- inclusive would double-count the boundary month\n",
    "# for every ~30-day renewal, which silently inflates retention almost everywhere.\n",
    "rows = []\n",
    "for row in ledger.itertuples(index=False):\n",
    "    start, end = int(row.age_start_month), int(row.age_end_month)\n",
    "    end = max(end, start + 1)\n",
    "    for m in range(start, end):\n",
    "        rows.append((row.channel, m, row.msno))\n",
    "active = pd.DataFrame(rows, columns=[\"channel\", \"age_month\", \"msno\"]).drop_duplicates()\n",
    "\n",
    "retention = active.groupby([\"channel\", \"age_month\"])[\"msno\"].nunique().reset_index(name=\"active_users\")\n",
    "retention = retention.merge(eligible, on=[\"channel\", \"age_month\"])\n",
    "retention[\"retention_rate\"] = (retention[\"active_users\"] / retention[\"eligible_users\"]).clip(upper=1.0)\n",
    "retention.head(8)\n"
   ]
  },
