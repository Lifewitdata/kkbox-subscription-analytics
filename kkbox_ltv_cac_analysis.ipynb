   "source": [
    "\n",
    "HORIZONS = [6, 12, 24]\n",
    "TARGET_RATIO = 3\n",
    "\n",
    "def ltv_at(channel, month):\n",
    "    curve = extrap[channel][\"curve\"]\n",
    "    return curve.get(month, np.nan)\n",
    "\n",
    "cac_table = []\n",
    "for channel in cohort_size.index:\n",
    "    row = {\"channel\": channel, \"users_acquired\": int(cohort_size[channel])}\n",
    "    for h in HORIZONS:\n",
    "        ltv_h = ltv_at(channel, h)\n",
    "        row[f\"LTV_{h}mo_NTD\"] = round(ltv_h)\n",
    "        row[f\"breakeven_CAC_{h}mo_NTD\"] = round(ltv_h)\n",
    "        row[f\"target_max_CAC_{h}mo_3to1_NTD\"] = round(ltv_h / TARGET_RATIO)\n",
    "    cac_table.append(row)\n",
    "\n",
    "cac_df = pd.DataFrame(cac_table).set_index(\"channel\")\n",
    "cac_df\n"
   ]
