    "\n",
    "# Parse dates, map channel codes to readable labels\n",
    "members[\"registration_init_time\"] = pd.to_datetime(members[\"registration_init_time\"], format=\"%Y%m%d\")\n",
    "txn[\"transaction_date\"] = pd.to_datetime(txn[\"transaction_date\"], format=\"%Y%m%d\")\n",
    "txn[\"membership_expire_date\"] = pd.to_datetime(txn[\"membership_expire_date\"], format=\"%Y%m%d\")\n",
    "members[\"channel\"] = members[\"registered_via\"].map(CHANNEL_NAMES).fillna(members[\"registered_via\"].astype(str))\n",
    "\n",
    "DATA_CUTOFF = txn[\"transaction_date\"].max()\n",
    "print(f\"Transaction data cutoff: {DATA_CUTOFF.date()}\")\n",
    "\n",
    "members[[\"msno\", \"city\", \"registered_via\", \"channel\", \"registration_init_time\"]].head()\n"
   ]
  },
