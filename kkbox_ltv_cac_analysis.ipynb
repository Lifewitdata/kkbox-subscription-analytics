    "\n",
    "members[\"max_obs_age\"] = ((DATA_CUTOFF - members[\"registration_init_time\"]).dt.days // 30).clip(lower=0, upper=MAX_AGE_MONTHS - 1)\n",
    "\n",
    "user_age_revenue = ledger.groupby([\"msno\", \"age_start_month\"])[\"actual_amount_paid\"].sum().reset_index()\n",
    "user_age_revenue = user_age_revenue.rename(columns={\"age_start_month\": \"age_month\"})\n",
    "\n",
    "pivot = user_age_revenue.pivot_table(index=\"msno\", columns=\"age_month\", values=\"actual_amount_paid\", fill_value=0)\n",
    "pivot = pivot.reindex(columns=range(MAX_AGE_MONTHS), fill_value=0)\n",
    "cum_pivot = pivot.cumsum(axis=1)\n",
    "\n",
    "max_obs = members.set_index(\"msno\")[\"max_obs_age\"]\n",
    "channel_map = members.set_index(\"msno\")[\"channel\"]\n",
    "\n",
    "ltv_rows = []\n",
    "for channel in cohort_size.index:\n",
    "    ch_users = channel_map[channel_map == channel].index\n",
    "    ch_cum = cum_pivot.loc[cum_pivot.index.intersection(ch_users)]\n",
    "    ch_max_obs = max_obs.loc[ch_cum.index]\n",
    "    for m in range(MAX_AGE_MONTHS):\n",
    "        mask = ch_max_obs >= m\n",
    "        n_elig = int(mask.sum())\n",
    "        if n_elig == 0:\n",
    "            continue\n",
    "        avg_ltv = ch_cum.loc[mask.index[mask], m].mean()\n",
    "        ltv_rows.append((channel, m, n_elig, avg_ltv))\n",
    "\n",
    "ltv_df = pd.DataFrame(ltv_rows, columns=[\"channel\", \"age_month\", \"eligible_users\", \"ltv_observed\"])\n",
    "\n",
    "# incremental (non-cumulative) revenue per active user per period, for extrapolation\n",
    "incr_revenue = ledger.groupby([\"channel\", \"age_start_month\"])[\"actual_amount_paid\"].sum().reset_index()\n",
    "incr_revenue = incr_revenue.rename(columns={\"age_start_month\": \"age_month\", \"actual_amount_paid\": \"incremental_revenue\"})\n",
    "ltv_df = ltv_df.merge(incr_revenue, on=[\"channel\", \"age_month\"], how=\"left\")\n",
    "ltv_df = ltv_df.merge(retention[[\"channel\", \"age_month\", \"active_users\"]], on=[\"channel\", \"age_month\"])\n",
    "ltv_df[\"arpu_per_active_user\"] = ltv_df[\"incremental_revenue\"] / ltv_df[\"active_users\"]\n",
    "\n",
    "ltv_df[ltv_df.channel == \"Organic/Web\"].head(10)\n"
   ]
